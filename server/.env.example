# Salin menjadi `.env` di server (jangan di-commit). Nilai di bawah contoh kosong.
PAPAN_DATA=data
PAPAN_PENYEDIA=penyedia.toml
# 1 bila server di belakang nginx/Cloudflare Tunnel (alamat asli dari CF-Connecting-IP)
PAPAN_PERCAYA_PROXY=1
# Folder model pengenal rumus (encoder_model.onnx, decoder_model.onnx, tokenizer.json)
PAPAN_MODEL_RUMUS=models/pix2text-mfr-1.5

OLLAMA_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
